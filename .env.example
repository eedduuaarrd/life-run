# Base de dades (Prisma)
DATABASE_URL=file:./dev.db

# URL pública del lloc (sense barra final)
NEXT_PUBLIC_SITE_URL=https://veylora.com

# Marca i contingut
VEYLORA_NAME=Veylora
VEYLORA_TAGLINE=El teu espai a Google Maps
VEYLORA_DESCRIPTION=Descobreix Veylora a Google Maps. Horaris, ubicació i contacte.

# NAP — ha de coincidir EXACTAMENT amb Google Business Profile
VEYLORA_STREET_ADDRESS=
VEYLORA_ADDRESS_LOCALITY=
VEYLORA_ADDRESS_REGION=
VEYLORA_POSTAL_CODE=
VEYLORA_ADDRESS_COUNTRY=ES

# Contacte
VEYLORA_PHONE=
VEYLORA_EMAIL=

# Coordenades (copia-les des de Google Maps → compartir → incrustar mapa)
VEYLORA_LAT=
VEYLORA_LNG=

# Enllaç directe al teu negoci a Google Maps (imprescindible per SEO local)
VEYLORA_GOOGLE_MAPS_URL=
# Opcional: Place ID (cerca "Place ID Finder" a Google)
VEYLORA_GOOGLE_PLACE_ID=

# Horari: una línia per dia, separades per |
# Exemple: Dilluns 9:00-18:00|Dimarts 9:00-18:00|...
VEYLORA_OPENING_HOURS=

# Opcional
VEYLORA_PRICE_RANGE=€€
VEYLORA_CATEGORY=LocalBusiness
