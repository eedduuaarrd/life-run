# Base de dades (Prisma)
DATABASE_URL=file:./dev.db

# URL pública del lloc — idealment veylora.com (ajuda molt a la cerca "veylora")
NEXT_PUBLIC_SITE_URL=https://veylora.com

# Marca (paraula clau principal: Veylora)
VEYLORA_NAME=Veylora
VEYLORA_TAGLINE=Lloc web oficial de Veylora
VEYLORA_DESCRIPTION=Veylora — web oficial de la marca. Informació i contacte quan cerquis Veylora a Google.

# Contacte (opcional)
VEYLORA_PHONE=
VEYLORA_EMAIL=

# Perfils socials (opcional, separats per |) — millora el reconeixement de marca
# VEYLORA_SOCIAL_URLS=https://instagram.com/veylora|https://linkedin.com/company/veylora

# Google Search Console (opcional): afegeix el codi a layout.tsx → metadata.verification.google
